# Copy to .env.local and fill in. Leave the Supabase values empty to run in
# "local mode" (data stays in this device's browser, IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sub-folder the app is served from. "/jd-one" for GitHub Pages, "" for a domain root.
NEXT_PUBLIC_BASE_PATH=

# Server-side only (scheduled Meta leads import; never NEXT_PUBLIC_)
META_LEADS_CSV_URLS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp → customer timeline sync (runs on the Mac where the bridges live; see ops/launchd)
WA_SYNC_ACCOUNTS=udaisarovar,pronite
WA_SYNC_CREATE_CUSTOMERS=false
WA_BRIDGE_ROOT=/Users/jyc/whatsapp-mcp
