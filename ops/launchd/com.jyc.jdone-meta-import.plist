<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac fallback for the Meta leads import (GitHub Action is the primary schedule).
  Runs `bun run import:meta` in /Users/jyc/jd-one every day at 08:05 (Mac local time = IST).
  Secrets are read from /Users/jyc/jd-one/.env.local (bun loads it automatically):
    META_LEADS_CSV_URLS, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

  Install:  cp ops/launchd/com.jyc.jdone-meta-import.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.jyc.jdone-meta-import.plist
  Run now:  launchctl start com.jyc.jdone-meta-import
  Logs:     ~/Library/Logs/jdone-meta-import.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jyc.jdone-meta-import</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/jyc/jd-one && /Users/jyc/.bun/bin/bun run import:meta</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/jyc/Library/Logs/jdone-meta-import.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jyc/Library/Logs/jdone-meta-import.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/jyc/.bun/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
